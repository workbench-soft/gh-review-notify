#!/bin/bash
# Stands in for the GitHub CLI. Each call is logged, and the answer comes from a
# JSON file in $FIXTURES named after the API path or the search flag.
printf '%s\n' "$*" >> "$GH_CALLS"

filter=""
words=()
while [ $# -gt 0 ]; do
  case "$1" in
    --jq) filter=$2; shift 2 ;;
    *) words+=("$1"); shift ;;
  esac
done

file=""
case "${words[0]} ${words[1]}" in
  "search prs")
    for flag in --author --involves --reviewed-by --review-requested; do
      [[ " ${words[*]} " == *" $flag "* ]] && file="search$flag.json"
    done
    ;;
  api\ *)
    for word in "${words[@]:1}"; do
      [[ $word == -* ]] && continue
      path=${word%%\?*}
      file="${path//\//_}.json"
      break
    done
    ;;
esac

answer="$FIXTURES/$file"
if [ "$file" = user.json ] && [ ! -f "$answer" ]; then
  echo "gh: not logged in" >&2
  exit 1
fi
[ -n "$file" ] && [ -f "$answer" ] || answer=/dev/null
if [ -n "$filter" ]; then
  jq -r "$filter" "$answer"
elif [ "$answer" = /dev/null ]; then
  echo '[]'
else
  cat "$answer"
fi
