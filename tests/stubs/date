#!/bin/bash
# Stands in for the BSD date of macOS, for the forms gh-review-notify uses.
# The clock reads $NOW and runs in UTC.
epoch=$NOW
format="%a %b %d %H:%M:%S UTC %Y"
while [ $# -gt 0 ]; do
  case "$1" in
    -u | -j) shift ;;
    -v-*d)
      days=${1#-v-}
      epoch=$((epoch - ${days%d} * 86400))
      shift
      ;;
    -f)
      epoch=$(jq -n --arg t "$3" '$t | fromdate') || exit 1
      shift 3
      ;;
    -r)
      epoch=$2
      shift 2
      ;;
    +*)
      format=${1#+}
      shift
      ;;
    *) exit 1 ;;
  esac
done

[ "$format" = "%s" ] && {
  echo "$epoch"
  exit 0
}

day=$(jq -rn --argjson e "$epoch" '$e | strftime("%d")')
format=${format//%-d/${day#0}}
jq -rn --argjson e "$epoch" --arg f "$format" '$e | strftime($f)'
